# Secrets — never in git history (stakes gate, coding-standard/README.md §4)
.env
*.key
*credentials*
*secret*

# Raw scraped/source data — immutable, regenerable, possibly license-restricted.
# NOTE: data/benchmark/ and data/annotations/ are human-approved project artifacts and
# ARE versioned — only raw/ is ignored.
data/raw/

# Large generated outputs (>100MB has no place in git; small final figures/tables OK)
results/checkpoints/
results/**/*.ckpt
results/**/*.pt
results/**/*.h5

# Python
__pycache__/
*.egg-info/
.venv/
.ipynb_checkpoints/

# Lean build products and downloaded dependencies
.lake/

# OS
.DS_Store

# Local agent session logs / run products
.claude/logs/
outputs/
