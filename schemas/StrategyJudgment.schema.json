{
  "additionalProperties": false,
  "description": "One independent strategy judgment; adjudication never replaces source labels.",
  "properties": {
    "classification": {
      "enum": [
        "match_A",
        "match_B",
        "mixed_or_alternative",
        "unresolved"
      ],
      "title": "Classification",
      "type": "string"
    },
    "explanation": {
      "minLength": 1,
      "title": "Explanation",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "signature_extractor",
        "llm_judge",
        "human",
        "adjudication"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "strategy_labels": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Strategy Labels",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "source_type",
    "source_id",
    "strategy_labels",
    "classification",
    "explanation"
  ],
  "title": "StrategyJudgment",
  "type": "object"
}
